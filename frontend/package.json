{
  "name": "woundscope-review-workbench",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
